name: Build Windows VST3
on:
  push:
    branches: [ main ]
jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: microsoft/setup-msbuild@v2
      - run: msbuild "Builds/VisualStudio2022/SEYA'S COMP.sln" /p:Configuration=Release /p:Platform=x64
      - run: choco install innosetup -y
      - run: iscc installer.iss
      - uses: actions/upload-artifact@v4
        with:
          name: SEYA-MUKISA-Windows-Installer
          path: SEYA_MUKISA_COMP_Windows_Installer.exe
